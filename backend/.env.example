# ============================================
# CONFIGURACIÓN BACKEND LSC - MODELO SEÑAS
# ============================================
# Copia este archivo a .env y ajusta los valores

# Entorno (development, staging, production)
ENV=development

# Puerto del servidor
API_PORT=8000

# Orígenes permitidos para CORS (separados por coma)
# Para desarrollo local:
CORS_ORIGINS=http://localhost:5173,http://localhost:19006
# Para producción:
# CORS_ORIGINS=https://tu-dominio.com,https://app.tu-dominio.com

# Ruta del modelo TensorFlow (relativa a backend/)
MODEL_PATH=models/best_advanced_lsc/model.weights.h5
LABELS_PATH=models/best_advanced_lsc/label_map.json

# Límite de requests por minuto
RATE_LIMIT=100
